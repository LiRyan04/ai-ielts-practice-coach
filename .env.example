# Used only to encrypt account-owned API keys at rest. Use a random value of
# at least 24 characters and keep the same value across deployments.
ACCOUNT_DATA_ENCRYPTION_KEY=

# Optional local-development identity. Production always uses ChatGPT login headers.
LOCAL_DEV_USER_EMAIL=local@ai-ielts.test
LOCAL_DEV_USER_NAME=Local Learner

# Optional neural TTS. When absent, Listening falls back to the browser voice.
# Qwen TTS reuses the account-owned DashScope key configured in Settings.
# MiMo TTS normally uses the account-owned key configured in Settings. This
# optional server fallback is useful for a single-user local installation.
MIMO_API_KEY=
OPENAI_API_KEY=
# This optional server-level key is used only when the current account has no saved key.
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry

# Optional provider-level fallbacks. Account-owned keys configured in Settings
# take priority; these are useful for a single-user local installation.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-odysseus-en
